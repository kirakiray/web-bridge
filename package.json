{
  "name": "web-bridge",
  "version": "0.1.0",
  "description": "MCP Server：AI 编辑器经 stdio 调用工具，间接在引入 client.js 的静态网页上 eval JS / 读取控制台 / 模拟操作",
  "type": "module",
  "main": "server.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirakiray/web-bridge.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "browser-automation",
    "websocket",
    "ai-tools"
  ],
  "scripts": {
    "start": "node server.js",
    "serve": "node server.js --transport http",
    "serve:groups": "node server.js --transport http --admin \"${ADMIN_PASSWORD:-123456}\"",
    "test": "node test/run-tests.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
