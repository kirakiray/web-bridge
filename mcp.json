{
  "_comment": "web-bridge MCP 配置模板（二选一）。http（推荐）：先在终端/服务器上运行 node server.js --transport http --port 3210，再把 url 指向该中转服务器；stdio：无需手动启动，编辑器按 _stdio_example 拉起 server.js 子进程（路径替换为本仓库绝对路径）。详见 README.md。",
  "mcpServers": {
    "web-bridge": {
      "type": "http",
      "url": "http://127.0.0.1:3210/mcp"
    }
  },
  "_stdio_example": {
    "mcpServers": {
      "web-bridge": {
        "command": "node",
        "args": ["<REPO>/server.js"],
        "env": {
          "PORT": "3210",
          "HOST": "127.0.0.1"
        }
      }
    }
  },
  "_remote_example": {
    "mcpServers": {
      "web-bridge": {
        "type": "http",
        "url": "https://your-domain.com/mcp",
        "headers": { "Authorization": "Bearer <secret>" }
      }
    }
  }
}
